# Copy this file to .env.local and fill in your Supabase project details
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sentry — error monitoring (https://sentry.io)
# Create a React project and paste the DSN from Settings → Client Keys
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Enable Sentry while running `npm run dev` (off by default in development)
# VITE_SENTRY_ENABLED=true

# Optional — for npm run latency (authenticated boot simulation)
# LATENCY_EMAIL=your@email.com
# LATENCY_PASSWORD=your-password
